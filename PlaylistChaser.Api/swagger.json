  "components": {
    "schemas": {
      "Playlist": {
        "required": [
          "channelName",
          "name",
          "originSourceId",
          "playlistTypeId",
          "userId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "channelName": {
            "minLength": 1,
            "type": "string"
          },
          "thumbnailId": {
            "type": "integer",
            "format": "int32"
          },
          "thumbnail": {
            "$ref": "#/components/schemas/Thumbnail"
          },
          "playlistTypeId": {
            "$ref": "#/components/schemas/PlaylistTypes"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "originSourceId": {
            "$ref": "#/components/schemas/SourceId"
          },
          "userId": {
            "type": "integer",
            "format": "int32"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        },
        "additionalProperties": false
      },
      "PlaylistInfo": {
        "required": [
          "creatorName",
          "isMine",
          "lastSynced",
          "name",
          "playlistIdSource",
          "url"
        ],
        "type": "object",
        "properties": {
          "playlistId": {
            "type": "integer",
            "format": "int32"
          },
          "playlist": {
            "$ref": "#/components/schemas/Playlist"
          },
          "sourceId": {
            "$ref": "#/components/schemas/SourceId"
          },
          "playlistIdSource": {
            "minLength": 1,
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "creatorName": {
            "minLength": 1,
            "type": "string"
          },
          "isMine": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "url": {
            "minLength": 1,
            "type": "string"
          },
          "lastSynced": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      },
      "PlaylistPopulated": {
        "type": "object",
        "properties": {
          "playlist": {
            "$ref": "#/components/schemas/Playlist"
          },
          "songs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Song"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PlaylistTypes": {
        "enum": [
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "RegisterUserModel": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Song": {
        "required": [
          "artistName",
          "songName"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "songName": {
            "minLength": 1,
            "type": "string"
          },
          "artistName": {
            "minLength": 1,
            "type": "string"
          },
          "thumbnailId": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SourceId": {
        "enum": [
          1,
          2
        ],
        "type": "integer",
        "format": "int32"
      },
      "Thumbnail": {
        "required": [
          "fileContents"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "fileContents": {
            "type": "string",
            "format": "byte"
          },
          "url": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "userName": {
            "type": "string",
            "nullable": true
          },
          "normalizedUserName": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "normalizedEmail": {
            "type": "string",
            "nullable": true
          },
          "emailConfirmed": {
            "type": "boolean"
          },
          "passwordHash": {
            "type": "string",
            "nullable": true
          },
          "securityStamp": {
            "type": "string",
            "nullable": true
          },
          "concurrencyStamp": {
            "type": "string",
            "nullable": true
          },
          "phoneNumber": {
            "type": "string",
            "nullable": true
          },
          "phoneNumberConfirmed": {
            "type": "boolean"
          },
          "twoFactorEnabled": {
            "type": "boolean"
          },
          "lockoutEnd": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "lockoutEnabled": {
            "type": "boolean"
          },
          "accessFailedCount": {
            "type": "integer",
            "format": "int32"
          },
          "dbUserName": {
            "type": "string",
            "nullable": true
          },
          "dbPassword": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}